# Only needed for the interpretation panel. Everything else runs without it.
# Locally: copy this file to .env and fill in the key.
# On Cloud Run: expose it from Secret Manager instead of setting it here.
GEMINI_API_KEY=""

# Optional. Defaults to gemini-3.6-flash.
# GEMINI_MODEL="gemini-3.6-flash"

# Optional. Cloud Run injects PORT automatically; 3000 is used locally.
# PORT=3000
